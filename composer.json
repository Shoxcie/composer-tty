{
    "name": "shoxcie/composer-tty",
    "description": "Run Composer scripts attached to the real console, so tools that ignore --ansi without a TTY keep their colors on Windows.",
    "license": "MIT",
    "keywords": [
        "composer",
        "scripts",
        "tty",
        "ansi",
        "colors",
        "windows"
    ],
    "require": {
        "php": "^8.5",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "composer/composer": "^2.10",
        "ergebnis/composer-normalize": "^2.53",
        "friendsofphp/php-cs-fixer": "^3.95",
        "laravel/pao": "^1.1",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Shoxcie\\ComposerTty\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --ansi",
        "cs:fix": "php-cs-fixer fix --diff --ansi",
        "phpstan": "phpstan analyse --ansi",
        "quality": [
            "@phpstan",
            "@rector:check",
            "@cs:check",
            "@test:types",
            "@test:coverage"
        ],
        "rector:check": "@tty rector process --dry-run",
        "rector:fix": "@tty rector process",
        "test": "pest",
        "test:coverage": "pest --coverage --min=100",
        "test:mutate": "pest --mutate --path=src --min=100",
        "test:types": "pest --type-coverage --min=100",
        "tty": "Shoxcie\\ComposerTty\\Tty::run"
    }
}
